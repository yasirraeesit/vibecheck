{
  "name": "vibecheck-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.1",
    "expo-camera": "~16.0.14",
    "expo-haptics": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.ts",
      "^expo-av$": "<rootDir>/__mocks__/expo-av.ts",
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.ts",
      "^react-native-view-shot$": "<rootDir>/__mocks__/react-native-view-shot.ts",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.ts",
      "^expo-status-bar$": "<rootDir>/__mocks__/expo-status-bar.ts",
      "^expo-camera$": "<rootDir>/__mocks__/expo-camera.ts"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
