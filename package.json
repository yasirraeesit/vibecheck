{
  "name": "vibecheck-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-av": "~15.0.1",
    "expo-camera": "~58.0.14",
    "expo-haptics": "~58.0.7",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.ts",
      "^expo-av$": "<rootDir>/__mocks__/expo-av.ts",
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.ts",
      "^react-native-view-shot$": "<rootDir>/__mocks__/react-native-view-shot.ts",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.ts",
      "^expo-status-bar$": "<rootDir>/__mocks__/expo-status-bar.ts",
      "^expo-camera$": "<rootDir>/__mocks__/expo-camera.ts"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
